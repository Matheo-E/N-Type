# Doxygen configuration for the N-Type C++ API documentation.

PROJECT_NAME           = "N-Type"
PROJECT_BRIEF          = "Client, server, protocol, and ECS API reference"
OUTPUT_DIRECTORY       = docs/api

INPUT                  = README.md \
                         client/src \
                         server/src \
                         common/protocol \
                         engine/include \
                         shared
RECURSIVE              = YES
FILE_PATTERNS           = *.hpp *.cpp
EXCLUDE_PATTERNS        = */build/* */vcpkg/*

EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
FULL_SIDEBAR            = YES
GENERATE_LATEX          = NO

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES

HAVE_DOT                = YES
UML_LOOK                = YES
CLASS_DIAGRAMS          = YES
CALL_GRAPH              = NO
CALLER_GRAPH            = NO
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES

QUIET                   = NO
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = NO

MARKDOWN_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE  = README.md
HTML_TIMESTAMP          = NO
