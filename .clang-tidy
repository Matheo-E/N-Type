---
# Mirrors the rules in docs/ARCHITECTURE.md: RAII, no raw new/delete, const
# correctness, explicit constructors, override, standard algorithms.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-explicit-virtual-functions,
  cppcoreguidelines-special-member-functions,
  google-explicit-constructor,
  misc-const-correctness,
  misc-unused-parameters,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-using,
  modernize-make-unique,
  performance-*,
  readability-identifier-naming,
  readability-else-after-return,
  readability-redundant-*
WarningsAsErrors: ''
HeaderFilterRegex: '(engine|rtype_common|server|client)/.*'
CheckOptions:
  - { key: readability-identifier-naming.ClassCase,           value: CamelCase }
  - { key: readability-identifier-naming.StructCase,          value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,            value: CamelCase }
  - { key: readability-identifier-naming.FunctionCase,        value: lower_case }
  - { key: readability-identifier-naming.VariableCase,        value: lower_case }
  - { key: readability-identifier-naming.ParameterCase,       value: lower_case }
  - { key: readability-identifier-naming.NamespaceCase,       value: lower_case }
  - { key: readability-identifier-naming.PrivateMemberSuffix, value: _ }
  - { key: readability-identifier-naming.ConstexprVariableCase,   value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix, value: k }
  - { key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor, value: true }
...
